{
  "name": "schafland",
  "version": "1.18.0",
  "private": true,
  "description": "Schafland – Spiel-Kasse für den Kinderkaufladen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "test": "node --import ./tests/unit/hilfen/svelte-register.mjs --test tests/unit/*.test.js",
    "test:e2e": "vite build && node tests/e2e/run.mjs",
    "test:fixtures": "node tests/e2e/fixtures.mjs",
    "test:explore": "vite build && node tests/e2e/explore.mjs",
    "build:starter": "vite build && node scripts/build-starter.mjs",
    "test:starter": "cd launcher && go test ./... && cd .. && node tests/e2e/starter.mjs",
    "build:apk": "vite build && cap sync android && cd android && ./gradlew assembleRelease",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/tap-runner": "^8.7.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.63.0",
    "svelte": "^5.57.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "dexie": "^4.4.7",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "zxing-wasm": "^3.1.6"
  }
}
