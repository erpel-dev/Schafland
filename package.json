{
  "name": "schafland",
  "version": "1.10.0",
  "private": true,
  "description": "Schafland – Spiel-Kasse für den Kinderkaufladen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "vite build && node tests/e2e/run.mjs",
    "test:fixtures": "node tests/e2e/fixtures.mjs",
    "test:explore": "vite build && node tests/e2e/explore.mjs",
    "build:starter": "vite build && node scripts/build-starter.mjs",
    "test:starter": "cd launcher && go test ./... && cd .. && node tests/e2e/starter.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "playwright": "^1.63.0",
    "svelte": "^5.57.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "dexie": "^4.4.7",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "zxing-wasm": "^3.1.6"
  }
}
